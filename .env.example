# Required for both Chat and Agent. Replace placeholders before starting the app.
AZURE_OPENAI_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=<deployment>

# Chat is the default. Set to Agent to use an AI Foundry agent instead.
ASSISTANT_TYPE=Chat

# Optional Chat settings (defaults shown).
USE_GENERAL_KNOWLEDGE=True
EMPHASIZE_RECENT_CONTENT=True
TOP_P_VALUE=0.8
TEMPERATURE_VALUE=0.2
MAX_TOKEN_LIMIT=1000000
DEFAULT_TOKEN_ENCODING=cl100k_base

# Optional Azure AI Search retrieval for Chat. Set both endpoint and index to enable.
# AZURE_AISEARCH_ENDPOINT=https://<search-service>.search.windows.net
# AZURE_AISEARCH_INDEX_NAME=<index-name>
# AZURE_AISEARCH_SEMANTIC_CONFIG=default-semantic-config
# TOP_N_DOCUMENTS=10
# SEARCH_STRICTNESS=3

# Optional AI Foundry Agent settings. Configure these when ASSISTANT_TYPE=Agent.
# AGENT_ID=<agent-name>
# AZURE_AIFOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_AGENT_VERSION=<agent-version>
# AGENT_ALT_ID=<alternative-agent-name>
# FOUNDRY_AGENT_ALT_VERSION=<alternative-agent-version>
# AGENT_FILE_METADATA_ONLY=True
# MAX_MESSAGE_LENGTH=256000
# AGENT_FILE_SIZE_LIMIT=100MB
# AZURE_AISEARCH_API_KEY=replace-with-your-search-api-key

# Optional shared assistant and UI settings.
# ASSISTANT_NAME=AI Assistent
# ASSISTANT_NAME_ID=default-assistant
# ASSISTANT_DESCRIPTION=
# PREDEFINED_QUESTIONS=Question 1;Question 2
# ALT_TOGGLE_LABEL=Brug alternativ assistent
# ALT_ALERT_MSG=
# ALT_ALERT_TYPE=info
# MAX_TOKEN_LIMIT_MESSAGE=98304
# AZURE_API_VERSION_OPENAI=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME_TITLE_GENERATION=<title-generation-deployment>

# Optional runtime settings.
# DEBUG=False
# PORT=8080
# CSP_FRAME_ANCESTORS='self' https://<allowed-origin>
# TITLE_GENERATION_MAX_CONCURRENCY=100
# TITLE_GENERATION_REQUEST_TIMEOUT_S=8
# TITLE_GENERATION_JOIN_TIMEOUT_S=9

# Optional Postgres integration. Persistence remains disabled unless all five are set.
# POSTGRES_USER=<database-user>
# POSTGRES_PASSWORD=replace-with-your-database-password
# POSTGRES_HOST=<database-host>
# POSTGRES_PORT=5432
# POSTGRES_DB=<database-name>

# Optional feedback email integration.
# FEEDBACK_SMTP_SERVER=<smtp-server>
# FEEDBACK_MAIL_RECIPIENT=<recipient@example.org>
# FEEDBACK_SMTP_PORT=25
# FEEDBACK_SMTP_SENDER_EMAIL=<sender@example.org>
# FEEDBACK_SMTP_SENDER_PASSWORD=replace-with-your-smtp-password
# FEEDBACK_SMTP_SENDER_NAME=<sender-name>

# Optional portal conversation loading. Required to validate load permits.
# CONVERSATION_LOAD_PERMIT_RS_PUBLIC_KEY_PEM=<public-key-pem>
# CONVERSATION_LOAD_PERMIT_ISSUER=gpt-dashboard-portal
# CONVERSATION_LOAD_PERMIT_AUDIENCE=chat-app
# CONVERSATION_LOAD_PERMIT_ALLOWED_KIDS=<kid-1>,<kid-2>

# Optional metrics labels.
# POD_NAME=pod_name_not_set
# METRICS_APP=ai-chat-app
# METRICS_DEPLOYMENT=unknown
# METRICS_INSTANCE=<pod-name>